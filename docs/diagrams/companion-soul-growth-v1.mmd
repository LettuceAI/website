  'background':'transparent',
  'primaryColor':'#1f2b22',
  'primaryTextColor':'#f4f4f5',
  'primaryBorderColor':'#4ade80',
  'lineColor':'#7dd3a6',
  'secondaryColor':'#18181b',
  'secondaryTextColor':'#e4e4e7',
  'secondaryBorderColor':'#52525b',
  'tertiaryColor':'#111827',
  'tertiaryTextColor':'#f4f4f5',
  'tertiaryBorderColor':'#22c55e',
  'fontSize':'21px'
}, 'flowchart': {
  'nodeSpacing': 40,
  'rankSpacing': 58,
  'curve': 'basis'
}}}%%
flowchart TD
  subgraph SOUL [The authored soul]
    direction TB
    S1[12 identity blocks<br/>essence, traits, backstory, appearance,<br/>goals, likes, fears, habits, and more]
  end

  A[You spend time<br/>chatting together] --> B[New companion<br/>memories form]
  B --> C[Growth cycle reviews<br/>the recent memories]
  C --> D{Does it reveal<br/>something new?}
  D -- No --> E[Nothing changes<br/>this cycle]
  D -- Yes --> F{How fast is that part<br/>allowed to change?}
  F -- Fixed core --> G[Left untouched<br/>identity stays stable]
  F -- Slow or fast tier --> H[Write a growth note]
  H --> I{Conflicts with<br/>earlier growth?}
  I -- Yes --> J[Supersede<br/>the old note]
  I -- No --> K[Add as<br/>new growth]
  J --> L[Consolidate<br/>related notes]
  K --> L
  L --> M[Overlay on the soul<br/>your authored text is never overwritten]
  M --> SOUL
  G --> SOUL

  SOUL --> N[Shapes how they<br/>speak, feel, and remember]
  E --> N
  SOUL --> V[You can review, edit, or remove<br/>any growth in the soul viewer]

  classDef accent fill:#14532d,stroke:#4ade80,color:#f0fdf4;
  class S1 accent;
